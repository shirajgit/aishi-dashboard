{
  "name": "aishi-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aishi Technologies internal operations dashboard (CRM, leads, subscriptions, outreach)",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix server run dev",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.2.1",
    "vite": "^7.2.4"
  }
}
